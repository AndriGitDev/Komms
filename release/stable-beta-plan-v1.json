{
  "schema": "komms-stable-beta-plan/v1",
  "plan_version": 1,
  "profile": "stable-v1",
  "pilot": {
    "id": "stable-v1-consent-alpha",
    "artifact_requirement": "production-like-signed-alpha",
    "minimum_consented_participants": 8,
    "maximum_consented_participants": 24,
    "minimum_completed_participants": 6,
    "maximum_duration_days": 21,
    "required_disclosures": [
      "Alpha software may fail, lose availability, or require recovery.",
      "The pilot is not suitable for emergency or safety-critical communication.",
      "Message content, contact graphs, stable user identifiers, and per-user timelines are not collected.",
      "Participation is voluntary and withdrawal does not claim deletion from peers, platform providers, or already aggregated reports.",
      "Named limitations, support boundaries, and the exact artifact digest are available before installation."
    ],
    "privacy_contract": {
      "message_content_collected": false,
      "contact_graph_collected": false,
      "stable_user_identifiers_collected": false,
      "per_user_timelines_collected": false,
      "raw_event_stream_retained": false,
      "aggregate_only_public_record": true,
      "consent_records_stored_separately": true
    },
    "metrics": [
      {
        "id": "install-completion",
        "kind": "rate",
        "minimum_samples": 6,
        "minimum_percent": 90
      },
      {
        "id": "contact-establishment-success",
        "kind": "rate",
        "minimum_samples": 6,
        "minimum_percent": 90
      },
      {
        "id": "first-message-within-15-minutes",
        "kind": "rate",
        "minimum_samples": 6,
        "minimum_percent": 80
      },
      {
        "id": "offline-delivery-success",
        "kind": "rate",
        "minimum_samples": 6,
        "minimum_percent": 90
      },
      {
        "id": "fallback-success",
        "kind": "rate",
        "minimum_samples": 4,
        "minimum_percent": 80
      },
      {
        "id": "crash-or-recovery-success",
        "kind": "rate",
        "minimum_samples": 2,
        "minimum_percent": 90
      },
      {
        "id": "mode-comprehension",
        "kind": "rate",
        "minimum_samples": 6,
        "minimum_percent": 80
      },
      {
        "id": "expected-notification-behavior",
        "kind": "rate",
        "minimum_samples": 6,
        "minimum_percent": 80
      },
      {
        "id": "critical-accessibility-blockers",
        "kind": "count",
        "maximum_count": 0
      },
      {
        "id": "privacy-boundary-incidents",
        "kind": "count",
        "maximum_count": 0
      },
      {
        "id": "support-minutes",
        "kind": "average",
        "minimum_samples": 6,
        "maximum_average": 60
      }
    ]
  },
